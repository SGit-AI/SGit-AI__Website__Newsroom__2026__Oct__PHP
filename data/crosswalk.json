{
 "about": "Where the site's graphs meet. Kept by the cartographer. The story graph (data/graph.json), the code-review graph (data/review.json) and the risk graph (data/grc-graph.json) each keep their own vocabulary; this file declares which of their nodes denote the same anchor, or a party and the class of stakeholder it belongs to, so a reader can step from one graph into the next. Bridges, not a merge (graphs.sgit.ai rule 7). The build refuses an id here that its graph does not have.",
 "kept_by": "cartographer",
 "graphs": {
  "story": {
   "file": "data/graph.json",
   "title": "the story graph"
  },
  "review": {
   "file": "data/review.json",
   "title": "the code-review graph"
  },
  "grc": {
   "file": "data/grc-graph.json",
   "title": "the risk graph"
  }
 },
 "relations": {
  "same_anchor": "the same thing, named in each graph",
  "is": "the party is this stakeholder",
  "among": "the party is one of this class of stakeholder"
 },
 "anchors": [
  {
   "anchor": "CVE-2026-109618",
   "relation": "same_anchor",
   "ids": {
    "story": "cve:CVE-2026-109618",
    "review": "cve-109618",
    "grc": "vulnerability:cve-109618"
   }
  },
  {
   "anchor": "CVE-2026-109619",
   "relation": "same_anchor",
   "ids": {
    "story": "cve:CVE-2026-109619",
    "review": "cve-109619",
    "grc": "vulnerability:cve-109619"
   }
  }
 ],
 "rules": [
  {
   "from": "review",
   "to": "grc",
   "relation": "same_anchor",
   "rule": "the risk graph names a review node '<kind>:<review id>', where kind is vulnerability, remediation or code (build_grc() in admin/build/build.py)"
  }
 ],
